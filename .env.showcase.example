# Copy this file to .env.showcase and replace the password before starting.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=telemetry
POSTGRES_DB=telemetry_showcase

# Only nginx is published, and only on the host loopback interface.
TELEMETRY_HTTP_PORT=8082

# The backend snapshot and simulator must refer to the same demo sensor.
TELEMETRY_DEMO_SENSOR_ID=MGD-PWR-01
TELEMETRY_DEMO_LOCATION=Magdeburg-Nord
TELEMETRY_DEMO_RETENTION_DAYS=7
TELEMETRY_SIMULATOR_INTERVAL_SECONDS=5
TELEMETRY_REQUEST_TIMEOUT_SECONDS=3
